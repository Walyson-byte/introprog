!----exercicio 03----!

lista = []

while True:
    desejo = input('Deseja adcionar algum participante[s/n]: ')
    if desejo == "s":
        lista.append(input('Nome do participante: '))
    else:
        print('Fechei a lista')
        break
print(set(lista))
print(f'A quantidade de inscritos foi: {len(lista)}')
print(f'A quantidade de inscritos diferentes foi: {len(set(lista))}')
print(f'Em ordem alfabética fica: {sorted(set(lista))}')
